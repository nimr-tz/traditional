APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
TRUSTED_PROXIES=*

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=15
MAIL_VERIFY_PEER=true
MAIL_VERIFY_PEER_NAME=true
MAIL_ALLOW_SELF_SIGNED=false

CRITICAL_ERROR_ALERTS_ENABLED=false
CRITICAL_ERROR_ALERT_MAILER=smtp
CRITICAL_ERROR_ALERT_RECIPIENTS=
CRITICAL_ERROR_ALERT_DEDUPE_MINUTES=15

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BILLING_ENABLED=true
BILLING_SANDBOX=true
BILLING_SYSTEM_URL=
BILLING_SYSTEM_CODE=TMSC-Test
BILLING_API_KEY=
BILLING_DEPT="NIMR HQ"
BILLING_REQUEST_RETRY_MINUTES=10
BILLING_CONNECT_TIMEOUT=5
BILLING_REQUEST_TIMEOUT=20
GEPG_PAYEE_NAME="NATIONAL INSTITUTE FOR MEDICAL RESEARCH"

# Comma-separated IPs the NIMR Billing System calls our /api/billing/* callbacks from.
# It sends no auth header, so this is the only verification available — leave
# BILLING_CALLBACK_TOKEN unset, or every genuine callback is rejected with a 403.
BILLING_CALLBACK_ALLOWED_IPS=
BILLING_CALLBACK_TOKEN=

# RevenueSourceItem IDs. config/billing.php already defaults to 39-42, the items
# AJSC uses — TMSC's fees match them exactly and they are fee_type=VARIABLE, so
# the amount comes from our payload. Only set these to override with TMSC-specific
# items once finance creates them. Leave commented out rather than blank.
# REV_participant_east_africa=39
# REV_participant_non_east_africa=40
# REV_student_east_africa=41
# REV_student_non_east_africa=42

# eGA mGov SMS gateway. Credentials are issued when the application is
# registered on the mGov Portal; until then leave SMS_SANDBOX=true, which logs
# each message (recipient and body) instead of sending it. SMS_ENABLED=false
# switches the channel off entirely — email is unaffected either way.
SMS_ENABLED=false
SMS_SANDBOX=true
SMS_GATEWAY_URL=https://mgov.gov.go.tz/gateway/sms/v2/send-sms
SMS_API_KEY=
SMS_SYSTEM_ID=
SMS_MOBILE_SERVICE_ID=
SMS_SENDER_ID=15200

# Per-message switches, so a message can be dropped without a code change.
SMS_ON_REGISTERED=true
SMS_ON_CONTROL_NUMBER=true
SMS_ON_PAYMENT_CONFIRMED=true
SMS_ON_ABSTRACT_DECISION=true
